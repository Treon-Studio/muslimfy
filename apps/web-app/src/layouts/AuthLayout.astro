---
import BaseLayout from './BaseLayout.astro';
import { Toaster } from '@/components/ui/toaster';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="min-h-screen bg-background max-w-md mx-auto flex items-center justify-center p-4">
    <slot />
  </div>
  <Toaster client:load />
</BaseLayout>
